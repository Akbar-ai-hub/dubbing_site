# Django
DJANGO_SECRET_KEY=change-this-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_DB_NAME=db.sqlite3
DJANGO_SECURE_SSL_REDIRECT=False
USE_X_FORWARDED_PROTO=True
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
CORS_ALLOWED_ORIGINS=

# CORS
CORS_ALLOW_ALL_ORIGINS=True

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
VIDEO_RETENTION_DAYS=7

# Dubbing pipeline
FFMPEG_BIN=ffmpeg
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-27b-it:free
DUBBING_SOURCE_LANGUAGE_NAME=English
DUBBING_TARGET_LANGUAGE_NAME=Kazakh
DIARIZATION_MODEL_NAME=pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=
COQUI_TTS_MODEL_NAME=facebook/mms-tts-kaz
DUBBING_SOURCE_LANGUAGE=en
TTS_TARGET_LANGUAGE=kk
MIN_SEGMENT_DURATION_SECONDS=0.6
MAX_UPLOAD_VIDEO_MB=100
ALLOWED_VIDEO_CONTENT_TYPES=video/mp4,video/quicktime,video/x-matroska,video/webm
VALIDATE_ORIGINAL_VIDEO_ENGLISH=False
